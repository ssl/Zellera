# Names and addresses of the game. Restart after a change: ./zel restart.
# Per-machine values go in config/zellera.local.env (not in git). The server reads these values itself and writes
# the ones the site uses into its settings rows; a value out of range stops the start with a message.

ZEL_GAME_NAME=Zellera
# Time zone of the dates and times players see and of the game's local days (opening hours, room clocks, paydays),
# as a name such as Europe/Amsterdam; empty: the settings row game.time_zone, else this machine's.
ZEL_TIME_ZONE=
# Landing view backdrop: a file in the landing view folder of ZEL_ASSET_DIR; empty: the client's own.
ZEL_LANDING_BACKDROP=

# How players reach the game (docs/PROXY.md):
#   local   this computer only, at https://$ZEL_HOST:$ZEL_HTTPS_PORT; ./zel start --public adds a quick tunnel
#   domain  Caddy on ports 80 and 443 for ZEL_DOMAIN, with a certificate it gets and renews itself
#   tunnel  a Cloudflare Tunnel (needs cloudflared): ZEL_TUNNEL_MODE=quick or named
#   none    your own proxy in front; only the database, the server and the web start
ZEL_PROXY=local
ZEL_HOST=zellera.localhost
ZEL_HTTPS_PORT=8444

# The game's public host name, for domain, none and a named tunnel: game.example.org
ZEL_DOMAIN=
# Other addresses the site is reached at (comma list of origins, https://other.example.org); empty: none.
#ZEL_EXTRA_ORIGINS=
# domain: where Caddy listens (empty: every address) and the e-mail address for the certificate's account (optional).
# none: where the web and the server listen (empty: 127.0.0.1, for a proxy on this computer).
ZEL_BIND=
ZEL_ACME_EMAIL=
# none: the proxies whose word on a player's address is taken (addresses or CIDR ranges, comma list), and the header
# they put it in.
#ZEL_TRUSTED_PROXIES=127.0.0.1
#ZEL_CLIENT_IP_HEADER=X-Forwarded-For

# tunnel: quick (a new trycloudflare.com address each start) or named (tunnel ZEL_TUNNEL at ZEL_DOMAIN, with its
# credentials in secrets/cloudflared-<name>.json, else in cloudflared's own folder).
ZEL_TUNNEL_MODE=quick
ZEL_TUNNEL=zellera
# Loopback port where Caddy serves cloudflared; cloudflared answers about itself on the next one.
ZEL_TUNNEL_PORT=9445

ZEL_WEB_PORT=8760
ZEL_WS_PORT=2076
ZEL_DB_PORT=3317
ZEL_DB_NAME=zellera

# Operator folders; relative paths are taken from the folder zel is in.
# The client build: `./zel import` installs the one a pack holds here (`--no-client` leaves it alone).
#ZEL_CLIENT_DIR=client
# Database passwords, web secrets and the key exchange's key, made on the first start.
#ZEL_SECRETS_DIR=secrets
#ZEL_ASSET_DIR=.data/assets
# The game's own data (camera photos, badges, furni lists), the gamedata the content pack brings, and the game rules.
#ZEL_DATA_DIR=.data/run/data
#ZEL_GAMEDATA_DIR=.data/gamedata
#ZEL_GAME_RULES_FILE=config/game-rules.conf
# Host a missing asset is fetched from (and kept); empty: never.
ZEL_ASSET_URL=

# YouTube Data API key the TV furni list their playlists with (housekeeping picks the playlists); empty: the TVs
# stay empty. Put it in config/zellera.local.env, it is a secret.
#ZEL_YOUTUBE_API_KEY=

# Key exchange between client and server, on top of TLS; it only hides the traffic from someone watching the websocket.
# 1: on, with this installation's own key, made in the secrets folder on the first start. 0: off, no key is made.
# ZEL_KEY_FILE names a key of your own instead: a file with the lines ZEL_RSA_N= and ZEL_RSA_D= (hex).
#ZEL_KEY_EXCHANGE=1
#ZEL_KEY_FILE=

# Operator switches, shown with their defaults.
# prod: no reusable login tickets, no debug pages, Secure cookies. dev: development mode, which only a game on this
# computer (ZEL_PROXY=local) takes; set it in config/zellera.local.env.
#ZEL_ENV=prod
# 1: registering needs ZEL_BETA_CODE (6 or more characters).
#ZEL_BETA_MODE=0
#ZEL_BETA_CODE=
# A folder under custom/themes or web/themes, or an absolute path; missing files come from web/themes/default.
#ZEL_WEB_THEME=default
# Comma list of folders under custom/extensions or web/extensions, or absolute folders (web/docs/EXTENSIONS.md);
# empty: none.
#ZEL_WEB_EXTENSIONS=guestbook
# Game extensions: comma list of folders under custom/game-extensions, or absolute folders (docs/GAME-EXTENSIONS.md);
# read at the server's start only. Empty: none.
#ZEL_GAME_EXTENSIONS=
# Shown to logged-out visitors (1) or only to players (0): community pages, photos, profiles, the API's game data.
#ZEL_WEB_PUBLIC_COMMUNITY=1
#ZEL_WEB_PUBLIC_PHOTOS=0
#ZEL_WEB_PUBLIC_PROFILES=0
#ZEL_WEB_PUBLIC_API=0
#ZEL_WEB_STAFF_PAGE=1
# 0: initials instead of avatar images.
#ZEL_WEB_AVATAR_IMAGES=1
# 1: a visitor without an account gets a guest account on the play theme (POST /guest). Off: no guest is ever made.
#ZEL_WEB_GUEST_ACCOUNTS=0
# Who may ask staff from the help page: account, anyone (leaves an e-mail address) or off.
#ZEL_WEB_HELP_TICKETS=account
# E-mail at registration: off, optional or required. The site never sends mail.
#ZEL_WEB_EMAIL=off
# Avatars per account (1-50); more than 1 logs in by e-mail and needs ZEL_WEB_EMAIL=required.
#ZEL_WEB_AVATARS_PER_ACCOUNT=1
# 0: the Wired Variables API of the public Web API is off.
#ZEL_WIRED_API=1
# Public API rate limit per IP: <per minute>/<per 10 seconds>, or off.
#ZEL_API_IP_LIMIT=600/150
# Game connections per IP (local ones not counted); 0: no cap.
#ZEL_MAX_CONNECTIONS_PER_IP=20
# Minutes between saves of each loaded room's state; 0: save on unload and stop only.
#ZEL_ROOM_SAVE_MINUTES=5
# 1: reusable test login tickets. Development mode only: with ZEL_ENV=prod the game refuses to start with it.
#ZEL_DEBUG_LOGIN=0
# 1: a game login must come from the device the play page measured for its ticket; needs a client that sends its
# device and a site that sends players through /play. 0: no device check.
#ZEL_DEVICE_CHECK=1
# Development only: a folder that keeps the newest 200 camera frames players send; empty: none.
#ZEL_CAMERA_SAMPLES_DIR=
# Development only: 1 makes every web database session read-only (a test instance of the web); logins then fail.
#ZEL_DB_READONLY=0
# Server heap (at least 256m) and InnoDB buffer pool; README.md, Server sizing.
#ZEL_SERVER_HEAP=2g
#ZEL_DB_BUFFER_POOL=128M
# Where the server jar comes from: source (built here, needs the JDK), release (the release's jar, checked against
# its sha256) or auto (the release's jar when ./zel upgrade fetched it, else built here).
#ZEL_BUILD=auto
# Backups kept in .data/backups, logs of earlier starts kept per process in .data/logs, and how long a start waits
# for the server (seconds).
#ZEL_BACKUP_KEEP=10
#ZEL_LOG_KEEP=5
#ZEL_START_TIMEOUT=120
